# ============================================================================
# VoltaX environment configuration (spec §48)
# Copy to `.env.local` and fill in. NEVER commit real secrets (see docs/SECURITY.md).
# ============================================================================

# --- Supabase (database + auth) ---------------------------------------------
# Safe to expose to the browser (public anon key, protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side ONLY. Full DB access, bypasses RLS. Never expose to the client:
SUPABASE_SERVICE_ROLE_KEY=

# --- Deriv API (market data + trading) --------------------------------------
# Server-side ONLY. The Deriv token must NEVER reach the browser (spec §8, §41).
DERIV_API_TOKEN=
DERIV_ACCOUNT_ID=
# Deriv application id. Register your own app at https://developers.deriv.com.
# Leaving this blank keeps VoltaX in fast, clearly-labelled demo mode.
DERIV_APP_ID=
# Deriv WebSocket endpoint. Default is the public endpoint.
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public

# --- Telegram alerts (optional) ---------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web Push / phone notifications (optional) ------------------------------
# Generate a keypair once: `node -e "console.log(require('web-push').generateVAPIDKeys())"`
# The PUBLIC key goes in BOTH VAPID_PUBLIC_KEY (server) and NEXT_PUBLIC_VAPID_PUBLIC_KEY
# (client). The PRIVATE key is server-side ONLY — never expose it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# A contact URI for the push services (mailto: or https:).
VAPID_SUBJECT=mailto:you@example.com

# --- AI explanation provider (optional) -------------------------------------
# Server-side ONLY. Used only to explain already-decided signals (spec §33, §67).
GEMINI_API_KEY=
# Use a rolling alias. Newer API keys get a 404 ("no longer available to new
# users") for pinned versions like gemini-2.5-flash; VoltaX auto-remaps the
# common ones, but the -latest aliases are the safe default.
GEMINI_MODEL=gemini-flash-latest
# Optional Claude fallback (only used when GEMINI_API_KEY is blank):
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Scheduled cloud alerts (optional) --------------------------------------
# Protects the /api/cron/alerts endpoint. Vercel Cron sends it automatically as
# `Authorization: Bearer <CRON_SECRET>`; an external scheduler can pass ?key=<value>.
# Generate any long random string. If blank, the endpoint is unauthenticated.
CRON_SECRET=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data source: 'live' (real Deriv public market data), 'demo' (labelled synthetic),
# or unset = live when Deriv is configured (default), with automatic demo fallback.
VOLTAX_DATA_SOURCE=

# Dev-only: comma-separated LAN origins allowed to load dev assets, e.g.
# 192.168.1.20 — needed only to open `npm run dev` from another device. Unused in
# production. Leave blank for localhost-only development.
VOLTAX_DEV_ORIGINS=
