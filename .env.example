# ============================================================================
# VoltaX environment configuration (spec §48)
# Copy to `.env.local` and fill in. NEVER commit real secrets (see docs/SECURITY.md).
# ============================================================================

# --- Supabase (database + auth) ---------------------------------------------
# Safe to expose to the browser (public anon key, protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side ONLY. Full DB access, bypasses RLS. Never expose to the client:
SUPABASE_SERVICE_ROLE_KEY=

# --- Deriv API (market data + trading) --------------------------------------
# Server-side ONLY. The Deriv token must NEVER reach the browser (spec §8, §41).
DERIV_API_TOKEN=
# Deriv application id (register at https://api.deriv.com). 1089 is Deriv's demo app id.
DERIV_APP_ID=1089
# Deriv WebSocket endpoint. Default is the public endpoint.
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3

# --- Telegram alerts (optional) ---------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- AI explanation provider (optional) -------------------------------------
# Server-side ONLY. Used only to explain already-decided signals (spec §33, §67).
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
